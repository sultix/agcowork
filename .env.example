# Copy to .env and adjust: cp .env.example .env
# Must not contain a semicolon (it is embedded in the connection string).
POSTGRES_PASSWORD=change-me-postgres
AGCOWORK_ADMIN_EMAIL=admin@agcowork.local
# At least 12 characters (the bootstrap admin is only created with a valid password).
AGCOWORK_ADMIN_PASSWORD=change-me-admin-pw
WEB_PORT=8080
# Compose network (AP-043): the api trusts X-Forwarded-For only from the web container's fixed address. Change these
# together if the subnet clashes with another network on the host.
# AGCOWORK_SUBNET=172.30.43.0/24
# AGCOWORK_IP_RANGE=172.30.43.128/25
# AGCOWORK_WEB_IP=172.30.43.10
