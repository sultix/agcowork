# Copy to .env and adjust: cp .env.example .env
# Must not contain a semicolon (it is embedded in the connection string).
POSTGRES_PASSWORD=change-me-postgres
AGCOWORK_ADMIN_EMAIL=admin@agcowork.local
# At least 12 characters (the bootstrap admin is only created with a valid password).
AGCOWORK_ADMIN_PASSWORD=change-me-admin-pw
WEB_PORT=8080
