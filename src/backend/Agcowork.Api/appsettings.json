{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agcowork": {
    "CredentialThrottling": {
      "Enabled": true,
      "MaxEntries": 50000,
      "Account": { "MaxFailures": 5, "Window": "00:15:00", "Lockouts": [ "00:01:00", "00:05:00", "00:15:00" ] },
      "Address": { "MaxFailures": 20, "Window": "00:15:00", "Lockouts": [ "00:15:00" ] },
      "PasswordChange": { "MaxFailures": 5, "Window": "00:15:00", "Lockouts": [ "00:01:00", "00:05:00", "00:15:00" ] }
    },
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  }
}
