{
  "name": "agcowork-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "api:generate": "openapi-typescript ../backend/Agcowork.Api/openapi/v1.json --output src/app/core/api/generated/schema.d.ts",
    "prestart": "npm run api:generate",
    "start": "ng serve",
    "prebuild": "npm run api:generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run api:generate",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "test:watch": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@microsoft/signalr": "^10.0.11",
    "@milkdown/kit": "^7.23.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "~1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.57.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "~1.9.0",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "dompurify": "^3.4.17"
  }
}
